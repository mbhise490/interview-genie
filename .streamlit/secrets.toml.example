# Streamlit Community Cloud Secrets Template
# In Streamlit Cloud: Go to App Settings -> Secrets, and paste your values below:

# Required: OpenAI API Key for parsing, interviewer agent, and feedback evaluator
OPENAI_API_KEY = "sk-proj-your-openai-api-key-here"

# Required: Secret key for signing candidate JWT tokens
JWT_SECRET_KEY = "interview_genie_super_secret_jwt_key_2026_change_me"

# Optional: If you want to connect to a cloud SQL Server (e.g. Azure SQL)
# Leave commented out to use the built-in self-contained SQLite cloud engine!
# SQL_SERVER = "your-server.database.windows.net"
# SQL_DATABASE = "InterviewGenie"
# SQL_USER = "your_username"
# SQL_PASSWORD = "your_password"
